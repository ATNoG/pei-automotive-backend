<!--
Scenario 09 - UNSAFE: two main-lane cars; first passes safely, second too close.
highway_in length = 182.49 m.  Both highway cars at 80 km/h (22.22 m/s).
Merging car at 60 km/h; trigger fires at t ≈ 2.6 s.

  main_car   : 130 m before MERGE (pos=52.49) → at trigger ≈ 72 m away.
               Reaches MERGE in 3.25 s; merging car already through → safe.

  main_car_2 :  90 m before MERGE (pos=92.49) → at trigger ≈ 32 m away.
               Reaches MERGE in 1.45 s; merging car still 20 m out (arrives in 1.2 s).
               At merging car arrival, main_car_2 ≈ 5 m past merge → gap < 20 m → unsafe.

Expected: unsafe (main_car_2 triggers collision alert)
-->
<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="40.0" minGap="2.5"/>

    <vehicle id="merging_car" type="car" depart="0.0"
             departLane="0" departPos="0" departSpeed="16.67">
        <route edges="entering highway_out"/>
    </vehicle>

    <!-- First highway car: 130 m before MERGE → 182.49 - 130 = 52.49 -->
    <vehicle id="main_car" type="car" depart="0.0"
             departLane="0" departPos="52.49" departSpeed="22.22">
        <route edges="highway_in highway_out"/>
    </vehicle>

    <!-- Second highway car: 90 m before MERGE → 182.49 - 90 = 92.49 -->
    <vehicle id="main_car_2" type="car" depart="0.0"
             departLane="0" departPos="92.49" departSpeed="22.22">
        <route edges="highway_in highway_out"/>
    </vehicle>
</routes>
