<!--
Scenario 10 - FALSE NEGATIVE: fast main-lane car (120 km/h) 140 m out —
beyond ENTRY_ZONE_M (100 m).

Merging car departs at pos=40.0 on entering (length 63.40 m), leaving only
23.4 m to MERGE → trigger fires almost immediately (t ≈ 0.2 s).
At that moment the highway car (starting 140 m before MERGE) has barely moved:
  140 - 0.2 * 33.33 ≈ 133 m from MERGE — outside ENTRY_ZONE_M → detector skips it.

At 120 km/h the highway car reaches MERGE in ≈ 4 s.  Real collision risk.

Expected (ground truth): unsafe
Detector output:          safe  (false negative — ENTRY_ZONE_M too short)
Fix:                      increase ENTRY_ZONE_M from 100 m to ≥ 150 m

highway_in length = 182.49 m.  Main car 140 m before MERGE: 182.49 - 140 = 42.49.
-->
<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="40.0" minGap="2.5"/>

    <!-- Merging car starts 23.4 m from MERGE: entering length 63.40 - 23.4 = 40.0 -->
    <vehicle id="merging_car" type="car" depart="0.0"
             departLane="0" departPos="40.0" departSpeed="16.67">
        <route edges="entering highway_out"/>
    </vehicle>

    <!-- 140 m before MERGE: 182.49 - 140 = 42.49 -->
    <vehicle id="main_car" type="car" depart="0.0"
             departLane="0" departPos="42.49" departSpeed="33.33">
        <route edges="highway_in highway_out"/>
    </vehicle>
</routes>
