<!--
Scenario 04 - SAFE: merging car very slow (20 km/h); main-lane car passes first.
highway_in length = 182.49 m.  Main car starts 55 m before MERGE (pos=127.49)
at 90 km/h (25 m/s) → reaches MERGE in 2.2 s.
Merging car at 20 km/h (5.56 m/s) takes 63.4 / 5.56 = 11.4 s to reach MERGE.
Trigger fires at t ≈ 7.8 s; main car is then ≈ 140 m past MERGE — outside
ENTRY_ZONE_M (100 m).
Expected: safe
-->
<routes>
    <vType id="car_slow" accel="1.5" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="10.0" minGap="2.5"/>
    <vType id="car_fast" accel="2.6" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="40.0" minGap="2.5"/>

    <vehicle id="merging_car" type="car_slow" depart="0.0"
             departLane="0" departPos="0" departSpeed="5.56">
        <route edges="entering highway_out"/>
    </vehicle>

    <!-- 55 m before MERGE: 182.49 - 55 = 127.49 -->
    <vehicle id="main_car" type="car_fast" depart="0.0"
             departLane="0" departPos="127.49" departSpeed="25.00">
        <route edges="highway_in highway_out"/>
    </vehicle>
</routes>
