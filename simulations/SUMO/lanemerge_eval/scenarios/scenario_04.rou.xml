<?xml version="1.0" encoding="UTF-8"?>
<!--
Scenario 04 - SAFE: merging car very slow (20 km/h), fast main-lane car passes first
The main-lane car is 55 m behind the merge at 90 km/h.  The merging car
is approaching the ramp at only 20 km/h.  By the time the merging car
reaches the merge point, the highway car has already long passed.
Predicted minimum distance >> COLLISION_THRESHOLD_M = 20 m.
Expected: lane_merge_safe.
-->
<routes>
    <vType id="car_slow" accel="1.5" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="10.0" minGap="2.5"/>
    <vType id="car_fast" accel="2.6" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="36.11" minGap="2.5"/>

    <!-- Merging car at 20 km/h (5.56 m/s) on the ramp -->
    <vehicle id="merging_car" type="car_slow" depart="0.0"
             departLane="0" departPos="0" departSpeed="5.56">
        <route edges="entering highway_out"/>
    </vehicle>

    <!-- Highway car 55 m before merge, at 90 km/h (25.0 m/s) -->
    <vehicle id="main_car" type="car_fast" depart="0.0"
             departLane="0" departPos="127.5" departSpeed="25.0">
        <!-- departPos = highway_in_length(182.5) - 55 = 127.5 -->
        <route edges="highway_in highway_out"/>
    </vehicle>
</routes>
