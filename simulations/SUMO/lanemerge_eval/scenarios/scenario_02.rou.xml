<?xml version="1.0" encoding="UTF-8"?>
<!--
Scenario 02 - SAFE: main-lane car 160 m past the merge point.
highway_out length = 202.36 m.  The car departs at pos=160 moving away from
MERGE; when the merging car arrives the main car is > 160 m past the
junction - well outside ENTRY_ZONE_M (100 m).
Expected: safe
-->
<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="40.0" minGap="2.5"/>

    <vehicle id="merging_car" type="car" depart="0.0"
             departLane="0" departPos="0" departSpeed="16.67">
        <route edges="entering highway_out"/>
    </vehicle>

    <!-- 160 m past merge on highway_out (length 202.36 m) -->
    <vehicle id="main_car" type="car" depart="0.0"
             departLane="0" departPos="160" departSpeed="22.22">
        <route edges="highway_out"/>
    </vehicle>
</routes>
