<?xml version="1.0" encoding="UTF-8"?>
<!--
Scenario 05 - SAFE: large time gap, both cars at 60 km/h
The main-lane car is 200 m behind the merge.  At 60 km/h (16.67 m/s)
it takes 12 s to reach the merge.  The merging car also travelling at
60 km/h on a 63 m ramp reaches the merge in ~3.8 s.  The highway car
is nowhere near the merge when the ramp car merges.
Expected: lane_merge_safe (no car in entry zone at trigger time).
-->
<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="33.33" minGap="2.5"/>

    <vehicle id="merging_car" type="car" depart="0.0"
             departLane="0" departPos="0" departSpeed="16.67">
        <route edges="entering highway_out"/>
    </vehicle>

    <!-- 200 m behind the merge on highway_in;
         highway_in is ~182.5 m, so place on highway_in at pos 0
         and start 200 m back = we put it at pos 0 on highway_in
         and give it an earlier depart to simulate extra distance. -->
    <vehicle id="main_car" type="car" depart="7.0"
             departLane="0" departPos="0" departSpeed="16.67">
        <!-- Departing 7 s later effectively creates a ~116 m extra gap -->
        <route edges="highway_in highway_out"/>
    </vehicle>
</routes>
