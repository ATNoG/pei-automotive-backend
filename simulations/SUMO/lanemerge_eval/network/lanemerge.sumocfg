<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="../../networkfile/barraOSM.net.xml"/>
        <!-- route-files is supplied at runtime by the scenario runner -->
    </input>
    <time>
        <begin value="0"/>
        <end value="120"/>
        <step-length value="0.1"/>
    </time>
    <report>
        <no-warnings value="true"/>
        <no-step-log value="true"/>
    </report>
    <processing>
        <collision.action value="warn"/>
        <collision.stoptime value="0"/>
    </processing>
</configuration>
