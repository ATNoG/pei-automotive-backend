<!--
Scenario 01 - TP: classic overtake
100 km/h car (lane 1) starts 30 m behind a 40 km/h car (lane 0).
Different lanes → no car-following. Closing rate 16.67 m/s → pass at ~1.8 s.
Expected: overtaking_event fires.
-->
<routes>
    <vType id="car_fast" accel="2.6" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="33.33" minGap="2.5"/>
    <vType id="car_slow" accel="1.5" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="13.89" minGap="2.5"/>

    <vehicle id="sumo-main-car" type="car_slow" depart="0.0"
             departLane="0" departPos="30" departSpeed="11.11">
        <route edges="highway"/>
    </vehicle>

    <vehicle id="sumo-merging-car" type="car_fast" depart="0.0"
             departLane="1" departPos="0" departSpeed="27.78">
        <route edges="highway"/>
    </vehicle>
</routes>
