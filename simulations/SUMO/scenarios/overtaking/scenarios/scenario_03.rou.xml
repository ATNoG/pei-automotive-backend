<!--
Scenario 03 – CONVOY: ego behind two slow vehicles in lane 0.
Ego   : departs at 0, 100 km/h, lane 0.
Slow1 : 55 km/h, 50 m ahead.
Slow2 : 55 km/h, 100 m ahead.
Expected: ego overtakes slow1 and slow2 sequentially.
-->
<routes>
    <vType id="ego_type"
           accel="3.0" decel="5.0" sigma="0.0"
           length="4.5" maxSpeed="33.33" minGap="2.5"
           color="0,0,255"/>

    <vType id="slow_type"
           accel="1.5" decel="4.5" sigma="0.0"
           length="4.5" maxSpeed="15.28" minGap="2.5"
           color="255,0,0"/>

    <vehicle id="slow2_03" type="slow_type" depart="0.0"
             departLane="0" departPos="100" departSpeed="15.28">
        <route edges="highway"/>
    </vehicle>

    <vehicle id="slow1_03" type="slow_type" depart="0.0"
             departLane="0" departPos="50" departSpeed="15.28">
        <route edges="highway"/>
    </vehicle>

    <vehicle id="ego_03" type="ego_type" depart="0.0"
             departLane="0" departPos="0" departSpeed="27.78">
        <route edges="highway"/>
    </vehicle>
</routes>
