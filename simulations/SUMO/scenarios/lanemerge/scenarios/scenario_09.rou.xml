<?xml version="1.0" encoding="UTF-8"?>
<!--
Scenario 09 - UNSAFE: two main-lane cars; first passes safely, second too close
main_car departs 130 m before the merge → safe (large gap).
main_car_2 departs 30 m before the merge → unsafe (same gap as scenario 06).
The merging car travels at 60 km/h.  The detector should fire unsafe for
the second car.
Expected: at least one lane_merge_unsafe alert.
-->
<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="33.33" minGap="2.5"/>

    <vehicle id="merging_car" type="car" depart="0.0"
             departLane="0" departPos="0" departSpeed="16.67">
        <route edges="entering highway_out"/>
    </vehicle>

    <!-- First highway car: 130 m before merge (safe) -->
    <!-- 182.5 - 130 = 52.5 m -->
    <vehicle id="main_car" type="car" depart="0.0"
             departLane="0" departPos="52.5" departSpeed="22.22">
        <route edges="highway_in highway_out"/>
    </vehicle>

    <!-- Second highway car: 30 m before merge (unsafe) -->
    <!-- 182.5 - 30 = 152.5 m -->
    <vehicle id="main_car_2" type="car" depart="0.0"
             departLane="0" departPos="152.5" departSpeed="22.22">
        <route edges="highway_in highway_out"/>
    </vehicle>
</routes>
