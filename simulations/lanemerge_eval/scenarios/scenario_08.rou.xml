<?xml version="1.0" encoding="UTF-8"?>
<!--
Scenario 08 - UNSAFE: slow merging car (40 km/h) with fast approaching main lane (120 km/h)

Trigger fires at ~3.9 s (43.4 m / 11.11 m/s).  The fast highway car (33.33 m/s)
starts 160 m from the merge so it is ~30 m away at trigger time.

The fast highway car reaches the merge ~0.9 s after trigger while the slow merging
car is still ~10 m from the merge.  Predicted gap < 20 m → unsafe.
Expected: lane_merge_unsafe.
-->
<routes>
    <vType id="car_slow" accel="1.5" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="15.0" minGap="2.5"/>
    <vType id="car_vfast" accel="3.0" decel="5.0" sigma="0.0" length="4.5"
           maxSpeed="40.0" minGap="2.5"/>

    <!-- Merging car at 40 km/h (11.11 m/s) -->
    <vehicle id="merging_car" type="car_slow" depart="0.0"
             departLane="0" departPos="0" departSpeed="11.11">
        <route edges="entering highway_out"/>
    </vehicle>

    <!-- Fast highway car 160 m before merge: 182.5 - 160 = 22.5 -->
    <vehicle id="main_car" type="car_vfast" depart="0.0"
             departLane="0" departPos="22.5" departSpeed="33.33">
        <route edges="highway_in highway_out"/>
    </vehicle>
</routes>
