<?xml version="1.0" encoding="UTF-8"?>
<!--
Scenario 07 - UNSAFE: same speed (60 km/h), ~30 m gap at detection trigger

Trigger fires at ~2.6 s (43.4 m / 16.67 m/s).  The highway car starts 73 m
from the merge so it is still ~30 m away at trigger time.

At t=1.2 s after trigger the merging car reaches the merge; the highway car is
~10 m from the merge.  Predicted gap at merge crossing < 20 m → unsafe.
Expected: lane_merge_unsafe.
-->
<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="33.33" minGap="2.5"/>

    <vehicle id="merging_car" type="car" depart="0.0"
             departLane="0" departPos="0" departSpeed="16.67">
        <route edges="entering highway_out"/>
    </vehicle>

    <!-- 73 m before merge: 182.5 - 73 = 109.5 -->
    <vehicle id="main_car" type="car" depart="0.0"
             departLane="0" departPos="109.5" departSpeed="16.67">
        <route edges="highway_in highway_out"/>
    </vehicle>
</routes>
