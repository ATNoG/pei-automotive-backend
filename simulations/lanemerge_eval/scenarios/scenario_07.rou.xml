<?xml version="1.0" encoding="UTF-8"?>
<!--
Scenario 07 - UNSAFE: merging car fast (100 km/h) onto slow main lane (30 km/h)
The merging car is going 27.78 m/s while the main-lane car ahead is only
8.33 m/s.  The merging car reaches the merge ~2.3 s after departure and
will immediately be on a collision course with the slow highway car
35 m ahead.  Predicted minimum distance < 20 m.
Expected: lane_merge_unsafe.
-->
<routes>
    <vType id="car_fast" accel="2.6" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="36.11" minGap="2.5"/>
    <vType id="car_slow" accel="1.5" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="12.0" minGap="2.5"/>

    <!-- Merging car at 100 km/h (27.78 m/s) -->
    <vehicle id="merging_car" type="car_fast" depart="0.0"
             departLane="0" departPos="0" departSpeed="27.78">
        <route edges="entering highway_out"/>
    </vehicle>

    <!-- Highway car 35 m before merge, at 30 km/h (8.33 m/s) -->
    <vehicle id="main_car" type="car_slow" depart="0.0"
             departLane="0" departPos="147.5" departSpeed="8.33">
        <!-- 182.5 - 35 = 147.5 -->
        <route edges="highway_in highway_out"/>
    </vehicle>
</routes>
