<?xml version="1.0" encoding="UTF-8"?>
<!--
Scenario 03 - SAFE: main-lane car just outside entry zone (110 m past merge)
The car has passed the merge by 110 m, which is just beyond
ENTRY_ZONE_M = 100 m, so the detector never considers it.
Expected: lane_merge_safe (no car in entry zone).
-->
<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="36.11" minGap="2.5"/>

    <vehicle id="merging_car" type="car" depart="0.0"
             departLane="0" departPos="0" departSpeed="16.67">
        <route edges="entering highway_out"/>
    </vehicle>

    <!-- 110 m past merge on highway_out, travelling at 90 km/h (25.0 m/s) -->
    <vehicle id="main_car" type="car" depart="0.0"
             departLane="0" departPos="110" departSpeed="25.0">
        <route edges="highway_out"/>
    </vehicle>
</routes>
