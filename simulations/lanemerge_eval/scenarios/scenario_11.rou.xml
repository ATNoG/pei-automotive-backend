<?xml version="1.0" encoding="UTF-8"?>
<!--
Scenario 11 - FALSE NEGATIVE: fast main-lane car (120 km/h) at 140 m from merge

The highway car is outside ENTRY_ZONE_M (100 m) when the merging car triggers
analysis. The detector skips it because dist_main_to_merge > ENTRY_ZONE_M.
At 120 km/h (33.3 m/s), the car reaches the merge in ~4.2 s - a real collision
risk that goes undetected.

Expected (ground truth): unsafe
Detector output:         safe  (false negative - ENTRY_ZONE_M too short)
Fix:                     increase ENTRY_ZONE_M from 100 m to at least 150 m
-->
<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="40.0" minGap="2.5"/>

    <vehicle id="merging_car" type="car" depart="0.0"
             departLane="0" departPos="0" departSpeed="16.67">
        <route edges="entering highway_out"/>
    </vehicle>

    <!-- 140 m before merge: highway_in_length(182.5) - 140 = 42.5 -->
    <vehicle id="main_car" type="car" depart="0.0"
             departLane="0" departPos="42.5" departSpeed="33.33">
        <route edges="highway_in highway_out"/>
    </vehicle>
</routes>
