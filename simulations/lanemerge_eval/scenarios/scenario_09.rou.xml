<?xml version="1.0" encoding="UTF-8"?>
<!--
Scenario 09 - UNSAFE: merging car slow (20 km/h), fast main-lane car (120 km/h)
The merging car crawls onto the highway at 5.56 m/s.  A fast highway car
at 33.33 m/s (120 km/h) is 55 m behind the merge point.  It reaches the
merge in ~1.65 s and, since the merging car has only moved ~9 m forward,
is directly in its path.  Predicted min distance < 20 m.
Expected: lane_merge_unsafe.
-->
<routes>
    <vType id="car_slow" accel="1.5" decel="4.5" sigma="0.0" length="4.5"
           maxSpeed="10.0" minGap="2.5"/>
    <vType id="car_vfast" accel="3.0" decel="5.0" sigma="0.0" length="4.5"
           maxSpeed="40.0" minGap="2.5"/>

    <!-- Merging car at 20 km/h (5.56 m/s) -->
    <vehicle id="merging_car" type="car_slow" depart="0.0"
             departLane="0" departPos="0" departSpeed="5.56">
        <route edges="entering highway_out"/>
    </vehicle>

    <!-- Fast highway car 55 m before merge: 182.5 - 55 = 127.5 -->
    <vehicle id="main_car" type="car_vfast" depart="0.0"
             departLane="0" departPos="127.5" departSpeed="33.33">
        <route edges="highway_in highway_out"/>
    </vehicle>
</routes>
